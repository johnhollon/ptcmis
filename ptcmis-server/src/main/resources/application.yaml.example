server:
  port: 9005
spring.jpa.open-in-view: false

spring.profiles.active: dev

spring:
  jpa:
    show-sql: false
    hibernate:
      ddl-auto: none
    properties:
      hibernate:
        format_sql: true
        order_inserts: true
        order_updates: true
        jdbc:
          batch_size: 500
---
spring.config.activate.on-profile: dev
spring:
  datasource:
    url: jdbc:mysql://yunjicn-dev-web-access.mysql.rds.aliyuncs.com:3306/dev_ptcmis?useUnicode=true&characterEncoding=GB18030&autoReconnect=true&rewriteBatchedStatements=true&serverTimezone=Asia/Shanghai
    username: username
    password: password
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      pool-name: primary@ds-hikari:mysql
      minimum-idle: 2
      maximum-pool-size: 2

---
spring.config.activate.on-profile: prod
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:9007/ptcmis?useUnicode=true&characterEncoding=GB18030&autoReconnect=true&rewriteBatchedStatements=true&serverTimezone=Asia/Shanghai
    username: username
    password: password
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      pool-name: primary@ds-hikari:mysql
      minimum-idle: 5
      maximum-pool-size: 10
