<configuration scan="true" scanPeriod="60 seconds" debug="false">

  <!-- 定义日志存放路径 -->
  <property name="LOG_PATH" value="./logs"/>
  <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

  <!-- 控制台输出 -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 滚动文件输出 -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/ptcmis-server.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <FileNamePattern>${LOG_PATH}/ptcmis-server.%d{yyyy-MM-dd}.log.gz</FileNamePattern>
      <MaxHistory>30</MaxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Hibernate SQL 日志：打印SQL语句 -->
  <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <!-- 打印SQL绑定参数值 (?, ?) 的实际值 -->
  <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <!-- Spring Data JPA仓库日志 -->
  <logger name="org.springframework.data.jpa" level="INFO"/>

  <!-- 业务包日志 -->
  <logger name="chenhuiran.ptcmisserver" level="DEBUG"/>

  <!-- 根日志级别 -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

  <!-- dev环境可开启TRACE，prod关闭SQL日志 -->
  <springProfile name="prod">
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="chenhuiran.ptcmisserver" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
  </springProfile>

</configuration>
