root = true

[*]
# 1. 通用配置 (CSS, LESS, SCSS, SASS)
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
ij_continuation_indent_size = 2
insert_final_newline = true
max_line_length = 150
ij_formatter_off_tag = @formatter:off
ij_formatter_on_tag = @formatter:on
ij_formatter_tags_enabled = true

# 1. 样式文件配置 (CSS, LESS, SCSS, SASS)
ij_css_use_double_quotes = true
ij_less_use_double_quotes = true
ij_scss_use_double_quotes = true
ij_sass_use_double_quotes = true
ij_css_enforce_quotes_on_format = true
ij_less_enforce_quotes_on_format = true
ij_scss_enforce_quotes_on_format = true
ij_sass_enforce_quotes_on_format = true

# 2. 脚本语言配置 (JS, TS, CJS, MJS 等)
ij_javascript_use_double_quotes = false
ij_javascript_force_quote_style = true
ij_javascript_import_sort_members = true
ij_javascript_import_sort_module_name = true
ij_javascript_blank_lines_around_method = 0
ij_typescript_use_double_quotes = false
ij_typescript_force_quote_style = true
ij_typescript_import_sort_members = true
ij_typescript_imports_wrap = off
ij_typescript_import_sort_module_name = true
ij_typescript_blank_lines_around_class = 0
ij_typescript_blank_lines_around_method = 0
ij_typescript_blank_lines_around_method_in_interface = 0

# 3. Vue 配置
ij_vue_indent_children_of_top_level = template

# 4. XML 文件
ij_xml_align_attributes = true

# 5. Markdown 关闭表格格式化

ij_markdown_continuation_indent_size = 4

# 5. 纯文本文件
[*.{md,txt}]
max_line_length = 80

[COPYING]
max_line_length = 80