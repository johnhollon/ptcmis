; NPM config file
; 参见： https://docs.npmjs.com/cli/v8/configuring-npm/npmrc

;
; 本文件属性名大小写敏感
;

;userconfig=${NODEJS_VERSION_MANAGER_ROOT_PATH}/configs/npmrc-user.ini
;init-module=${NODEJS_VERSION_MANAGER_ROOT_PATH}/configs/npm-init.js
;globalignorefile=${NODEJS_VERSION_MANAGER_ROOT_PATH}/configs/npmignore.ini
;cache=${NODEJS_VERSION_MANAGER_ROOT_PATH}/repositories/cache
;prefix=${NODEJS_VERSION_MANAGER_ROOT_PATH}/repositories/repos
;scripts-prepend-node-path=true

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;     下面是常用的代理配置     ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; NPM主包仓库 阿里云 npm mirror
;registry=https://registry.npmmirror.com


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;     其它各类代理定义参见 ./.npm-install-envs 文件    ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
